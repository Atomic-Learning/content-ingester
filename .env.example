# GitHub Personal Access Token
# Create a token at: https://github.com/settings/tokens
# 
# Scope options:
# - For PUBLIC repos only: use "public_repo" scope (more restrictive)
# - For PRIVATE repos: use "repo" scope (full control)
# - No token needed: public repos can be cloned without authentication
#   (but with lower rate limits)
GITHUB_PAT=your_github_pat_here

# API Base URL for content export endpoints
# Example: https://api.example.com
API_BASE_URL=http://atomic.dept.ic.ac.uk

# Author names for generated content
# Comma-separated list of author slugs (lowercase, hyphen-separated)
# Used by the set-authors-from-env skill to populate metadata.json files
# Example: CONTENT_INGESTER_AUTHORS=john-doe,jane-smith,chris-cooling
CONTENT_INGESTER_AUTHORS=

# Content ingestion path overrides (relative to repository root or absolute paths)
CONTENT_INGESTER_INPUTS_DIR=inputs
CONTENT_INGESTER_OUTPUTS_DIR=outputs
