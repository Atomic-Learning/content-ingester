{
  "name": "content-ingester",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "postCreateCommand": "python -m venv .venv && . .venv/bin/activate && python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "GNDEV.md-mermaid-preview-support",
        "george-alisson.html-preview-vscode",
        "shd101wyy.markdown-preview-enhanced"
      ]
    }
  }
}
